# Algolia DocSearch credentials for the ⌘K search dialog.
#
# Leave these unset for local development: with no app id configured, the search button is simply
# inert and the rest of the site works normally.
#
# Do NOT paste Algolia's public demo credentials here (app id R2IYF7ETH7, index "docsearch"). They
# work, which is the problem — they search Algolia's own demo documentation instead of SeAT+, so
# search looks functional while returning results from an unrelated site.
#
# To get real values, apply for the free DocSearch program at https://docsearch.algolia.com/apply/
# and use the credentials it issues for this site's index.
NEXT_PUBLIC_DOCSEARCH_APP_ID=
NEXT_PUBLIC_DOCSEARCH_API_KEY=
NEXT_PUBLIC_DOCSEARCH_INDEX_NAME=
